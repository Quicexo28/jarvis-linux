[Unit]
Description=Jarvis UI (Tauri)
After=jarvis-backend.service graphical-session.target
Requires=jarvis-backend.service

[Service]
Type=simple
# Esperar el socket Wayland real: en el boot, graphical-session.target llega
# antes de que Hyprland cree wayland-1 y Tauri hace panic (exit 101) — se veía
# como "el binario ni arranca" con restart counter 2-3 en cada boot.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && exit 0; sleep 0.5; done; echo "wayland socket timeout" >&2; exit 1'
# Antiparpadeo de la cámara a 60 Hz (red eléctrica de Colombia). Venía en
# 50 Hz de fábrica: bajo luz LED/fluorescente a 60 Hz eso mete bandas de brillo
# que cambian frame a frame y el modelo de manos pierde la mano. El control no
# persiste entre reconexiones USB, por eso se fija en cada arranque. «-» = no
# bloquear la UI si la cámara no está.
ExecStartPre=-/usr/bin/v4l2-ctl -d /dev/v4l/by-id/usb-SunplusIT_Inc_HD_User_Facing-video-index0 -c power_line_frequency=2
ExecStart=/home/santiago2/jarvis-linux/frontend/src-tauri/target/release/jarvis
Restart=on-failure
RestartSec=3
# El ExecStartPre espera hasta 30 s por el socket Wayland, pero el manager de
# usuario trae DefaultTimeoutStartSec=15s: systemd mataba el start-pre a los 15 s
# y el servicio entraba en bucle de reinicios (32 seguidos el 2026-07-24 16:20).
TimeoutStartSec=90
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=DISPLAY=:1
Environment=GDK_BACKEND=wayland
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
# Portátil híbrido (Intel UHD + RTX 3050): tras la actualización del 2026-09-29
# (nvidia 615, webkit2gtk 2.52.6) glvnd pasó a darle a WebKitWebProcess la EGL
# de NVIDIA (renderD129) mientras Hyprland compone en la Intel. Cada frame
# cruzaba de GPU pasando por CPU: lag, zoom raro y `WebGLRenderer: Context Lost`.
# Forzar la EGL de Mesa deja todo en la iGPU (comprobar: fds de WebKitWebProcess
# → renderD128, y `nvidia-smi` sin WebKit).
Environment=__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
Environment=__GLX_VENDOR_LIBRARY_NAME=mesa
# Regresión webkit2gtk 2.54.x (2.54.2, 2026-10-29): un <video srcObject>, oculto
# o visible, queda en readyState 0 (0x0) y play() nunca resuelve, así que los
# gestos se quedaban en `starting`. Con esta variable: 640x360, readyState 3,
# play() en ~1,5 s.
Environment=WEBKIT_GST_ALLOW_PLAYBACK_OF_INVISIBLE_VIDEOS=1
Environment=WEBKIT_INSPECTOR_SERVER=127.0.0.1:9222

[Install]
WantedBy=default.target
