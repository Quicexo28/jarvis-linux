[Unit]
Description=Jarvis Backend (Node.js API + static frontend)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/jarvis-linux/backend
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=8788
Environment=HOST=::
# Set to your enrolled speaker name so voice commands run as OWNER (full access).
# Must match the speaker name used when enrolling samples in SpeakerIdPanel.
Environment=JARVIS_OWNER_SPEAKER=santiago
# Obsidian vault — Jarvis brain. Activates read/write integration.
Environment=JARVIS_OBSIDIAN_VAULT=%h/Jarvis-Vault
Environment=JARVIS_OWNER_NAME=Santiago
Environment=JARVIS_OBSIDIAN_API_URL=https://127.0.0.1:27124/
Environment=JARVIS_OBSIDIAN_API_KEY=Bearer 06b6afd1156e5feb4ad67a17432e0a5c5e74c0337a66e60a02c48765fc77020b

[Install]
WantedBy=default.target

