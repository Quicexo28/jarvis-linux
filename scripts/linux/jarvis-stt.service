[Unit]
Description=Jarvis STT Service (faster-whisper)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/jarvis-linux/backend/voice/python
ExecStart=%h/jarvis-linux/backend/voice/python/.venv/bin/python stt_service.py
Restart=on-failure
RestartSec=5
Environment=LD_LIBRARY_PATH=%h/jarvis-linux/backend/voice/python/.venv/lib/python3.11/site-packages/nvidia/cublas/lib:%h/jarvis-linux/backend/voice/python/.venv/lib/python3.11/site-packages/nvidia/cuda_runtime/lib
# GPU path: TTS migrated to cloud edge-tts, freeing VRAM, so STT runs the FULL
# large-v3 on the RTX 3050 — better Spanish accuracy than the distilled turbo.
# compute=int8_float16 (int8 weights, fp16 math) keeps it to ~1.8 GB VRAM so it
# fits the 4 GB card; full float16 OOMs (~3.1 GB + CUDA/cublas overhead > 4 GB).
# speaker-id runs on CPU (SPEAKER_ID_DEVICE=cpu) to leave VRAM for whisper; on
# OOM stt_service.py auto-steps down to turbo, then CPU.
# Restart=on-failure + RestartSec recover the known suspend/resume CUDA
# "invalid device ordinal" by relaunching. If VRAM contention returns, pin
# WHISPER_MODEL=large-v3-turbo, or WHISPER_DEVICE=cpu / WHISPER_MODEL=small.
Environment=WHISPER_DEVICE=cuda
Environment=WHISPER_MODEL=large-v3
Environment=WHISPER_COMPUTE=int8_float16
Environment=SPEAKER_ID_DEVICE=cpu
# Denoise mode: highpass | deepfilter | spectral | off. deepfilter = neural
# denoise (DeepFilterNet, CPU real-time) feeding ONLY the whisper path —
# speaker-id always gets raw audio, so denoise can't degrade identification.
# Auto-falls back to highpass if deepfilternet isn't installed.
Environment=STT_DENOISE_MODE=deepfilter
# Speaker encoder: ecapa (default, best separation) | resemblyzer (legacy).
# Changing this requires regenerating owner_voiceprint.enc
# (scripts/create-voiceprint.sh) — WAV samples re-embed automatically.
Environment=SPEAKER_ENCODER=ecapa
Environment=JARVIS_OWNER_SPEAKER=santiago
# Endpointing: chunks of silence (32ms each) — HARD CAP before a segment
# finalizes. 31 -> ~0.99s. Adaptive tiers finalize sooner: ~0.51s when the
# speculative transcript ends in .!? and ~0.70s when it has no continuation
# cue (trailing comma/conjunction waits the full cap). Whisper omitting
# terminal punctuation no longer forces the long wait, and a lone 32ms noise
# blip (fan) no longer resets the silence tail (STT_RESUME_CHUNKS debounce).
Environment=STT_SILENCE_CHUNKS=31
# Speculative decode fires after this many silence chunks (12 -> ~0.38s).
# Earlier spec = whisper result ready sooner = early-final fires more often and
# the final endpoint rarely waits on the decode. A pause that resumes just
# wastes one spec decode (GPU idle at that moment anyway).
Environment=STT_SPEC_AT=12

[Install]
WantedBy=default.target
