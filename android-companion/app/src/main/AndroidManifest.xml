<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dictation: the WebView has no SpeechRecognition API, so the shell
         records with SpeechRecognizer and hands the text to the page. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Huella/PIN antes de firmar el reto de acciones de riesgo (Elevation.kt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Modo proyector: lanzar Moonlight desde BOOT_COMPLETED es un arranque de
         activity en segundo plano, prohibido desde Android 10. Esta permiso es
         la exencion; se concede una sola vez con
         `adb shell appops set com.jarvis.companion SYSTEM_ALERT_WINDOW allow`.
         Sin ella el sistema descarta el arranque EN SILENCIO. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Modo pared (wall/WallService): Android 14 exige tipo para cada servicio
         en primer plano. specialUse no tiene requisitos previos ni el tope de
         6 h de dataSync en Android 15. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Modo pared, solo si se conceden por adb (ninguna app los obtiene sola):
         - WRITE_SECURE_SETTINGS (`pm grant`): el WindowManager de fábrica del
           HA109 BORRA enabled_accessibility_services en cada cambio de ventana
           con foco (DisplayContent.enableNfxAccessibility, ver docs). La pared
           vuelve a activar su servicio de accesibilidad en cuanto lo borran.
         - PACKAGE_USAGE_STATS (`appops set … GET_USAGE_STATS allow`): saber qué
           app está delante aunque la accesibilidad esté caída en ese momento.
         En la tablet y el móvil nadie los concede y no hacen nada. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ hides other packages unless declared. Without this,
         `openMoonlight` cannot even tell whether Moonlight is installed:
         getPackageInfo throws NameNotFoundException for a package that is
         plainly there, and the button would always fall back to the store. -->
    <queries>
        <package android:name="com.limelight" />
        <package android:name="com.limelight.noir" />
        <!-- The Tailscale widget has to know whether Tailscale is installed
             before offering to toggle it. -->
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- Modo pared: el mosaico lista y lanza las apps de TV del proyector
             (y las de launcher normal como respaldo). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Cleartext allowed so the LAN backend (http://IP:8788) works; the
         tunnel/Tailscale URLs are https anyway. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="Jarvis"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- WebView host. configChanges keeps the page alive through rotation
             and keyboard show/hide instead of reloading the whole UI. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="Ajustes de Jarvis"
            android:windowSoftInputMode="adjustResize" />

        <!-- Voice overlay: what the 2x2 hologram opens. Translucent and
             singleInstance so tapping the widget twice does not stack two mics.
             The ASSIST filter lets it be picked as the system assistant. -->
        <activity
            android:name=".voice.VoiceActivity"
            android:exported="true"
            android:theme="@style/JarvisVoiceOverlay"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Compartir → Jarvis": entra en la hoja de compartir del sistema
             para CUALQUIER tipo (`*/*`), sube a /api/vault/ingest y deja que
             pdfWatcher convierta a markdown. Sin UI: translucida, noHistory y
             fuera de recientes, porque es un puente, no una pantalla. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:icon="@drawable/ic_launcher"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Invisible trampoline for widget taps (see WidgetActionActivity). -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true" />

        <receiver
            android:name=".widget.JarvisWidget"
            android:exported="false"
            android:label="@string/widget_label_jarvis">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_jarvis_info" />
        </receiver>

        <receiver
            android:name=".widget.TailscaleWidget"
            android:exported="false"
            android:label="@string/widget_label_tailscale">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tailscale_info" />
        </receiver>

        <receiver
            android:name=".widget.DesktopWidget"
            android:exported="false"
            android:label="@string/widget_label_desktop">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_desktop_info" />
        </receiver>

        <service
            android:name=".ReporterService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ===== Modo pared (paquete wall): todo inactivo sin Config.wallMode ===== -->

        <!-- La pared: decoder + warp + inicio con mosaico. No exportada: la
             abren el servicio, el boot y WallConfigActivity. Afinidad propia
             para no mezclarse con la tarea del WebView. -->
        <activity
            android:name=".wall.WallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.jarvis.companion.wall"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|uiMode" />

        <!-- Control del keystone del proyector (tablet → proyector, sin PC). -->
        <activity
            android:name=".wall.KeystoneActivity"
            android:label="Keystone"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keystone de hardware por HTTP (8451), vivo desde el arranque. -->
        <service
            android:name=".wall.KeystoneService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keystone_http" />
        </service>

        <!-- Inicio del proyector (lo abre HomeTrampolineActivity). Sin GL ni red. -->
        <activity
            android:name=".wall.LauncherActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.jarvis.companion.launcher"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|uiMode" />

        <!-- HOME del proyector. DESHABILITADA aquí: en la tablet y el móvil
             (mismo APK) un candidato a HOME más haría que el sistema
             preguntara qué launcher usar. WallHome.syncTrampoline la habilita
             solo con wallMode && homeMode. Sin GL ni red: si crashea en bucle
             con ADB apagado el proyector queda inservible. -->
        <activity
            android:name=".wall.HomeTrampolineActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Configuración por `am start` con extras. WRITE_SECURE_SETTINGS la
             tiene el shell de adb y ninguna app de terceros: nadie más puede
             apuntar la pared a otro server. -->
        <activity
            android:name=".wall.WallConfigActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <service
            android:name=".wall.WallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cliente de pantalla: mantiene la conexión con el servidor de la pared mientras otra app está delante" />
        </service>

        <service
            android:name=".wall.WallAccessibilityService"
            android:exported="true"
            android:label="@string/wall_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/wall_accessibility" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
