<?xml version="1.0" encoding="utf-8"?>
<!-- 1x2 pill split into one zone per machine: tap the left half to stream from
     one PC, the right half for the other. Three zones are laid out and hidden as
     needed, because the machine list is discovered, not fixed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_pill"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/dk_slot0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/dk_icon0"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_monitor"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/dk_text0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/jarvis_text"
            android:text="@string/widget_desktop_title" />
    </LinearLayout>

    <!-- FrameLayout, not View: RemoteViews only guarantees a fixed set of view
         classes, and a bare View is not on it. -->
    <FrameLayout
        android:id="@+id/dk_div1"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/jarvis_line" />

    <LinearLayout
        android:id="@+id/dk_slot1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/dk_icon1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_monitor"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/dk_text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/jarvis_text" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/dk_div2"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/jarvis_line" />

    <LinearLayout
        android:id="@+id/dk_slot2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/dk_icon2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_monitor"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/dk_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/jarvis_text" />
    </LinearLayout>
</LinearLayout>
