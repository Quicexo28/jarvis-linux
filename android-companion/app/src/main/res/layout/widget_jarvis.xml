<?xml version="1.0" encoding="utf-8"?>
<!-- Everything visible is the bitmap: card, rings, core and wordmark are drawn
     by ui/Holo.kt, because RemoteViews cannot express a radial gradient. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/holo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/holo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_jarvis_desc" />
</FrameLayout>
