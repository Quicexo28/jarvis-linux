<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface for the Tailscale widget: near-black with a faint top-lit
     gradient and a hairline border, matching the app's card style. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:startColor="#FF0E1620"
        android:endColor="#FF070B12"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#FF1B2635" />
</shape>
