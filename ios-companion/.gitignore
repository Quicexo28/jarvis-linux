# Everything Xcode/XcodeGen produces. The spec (project.yml) is the source of
# truth; the .xcodeproj is regenerated on every build, including in CI.
*.xcodeproj/
*.xcworkspace/
build/
DerivedData/
Payload/
*.ipa

# Generated by XcodeGen from the `info.properties` blocks in project.yml.
Sources/App/Info.plist
Sources/Widgets/Info.plist

.DS_Store
